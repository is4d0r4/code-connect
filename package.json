{
  "name": "code-connect-workspace",
  "version": "1.0.0",
  "description": "Workspace com React + Vite e NestJS",
  "private": true,
  "pnpm": {
    "workspaces": [
      "apps/*"
    ]
  },
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:preview": "pnpm --filter web preview",
    "web:lint": "pnpm --filter web lint",
    "api:dev": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start",
    "api:test": "pnpm --filter api test",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "dev": "pnpm -r --parallel dev start:dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter api test:e2e"
  }
}
